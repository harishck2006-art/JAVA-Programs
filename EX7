import javax.swing.*;
import java.awt.*;
import java.awt.event.MouseAdapter;
import java.awt.event.MouseEvent;

/**
 * A Java Swing frame that demonstrates event handling for a button and a mouse.
 */
public class ImageFrame extends JFrame {

    // Declare GUI components
    private JTextField clickTextField;
    private JButton clickButton;
    private JLabel imageLabel;

    // Icons for original and enlarged states
    private ImageIcon originalIcon;
    private ImageIcon enlargedIcon;

    // Counter for button clicks
    private int clickCount = 0;

    /**
     * Constructor to set up the GUI.
     */
    public ImageFrame() {
        // 1. Configure the frame
        setTitle("Image and Button Demo");
        setSize(500, 500);
        setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
        setLayout(new BorderLayout(10, 10)); // Layout with 10px gaps

        // 2. Create and configure components
        clickTextField = new JTextField("Button Clicks: 0", 20);
        clickTextField.setEditable(false);
        clickTextField.setHorizontalAlignment(JTextField.CENTER);
        clickTextField.setFont(new Font("Arial", Font.BOLD, 14));

        clickButton = new JButton("Click Me!");
        clickButton.setFont(new Font("Arial", Font.PLAIN, 14));

        // Load the original image. Ensure 'icon.png' is in the project root.
        originalIcon = new ImageIcon("image.png");

        // Create scaled versions of the image for display
        Image originalImg = originalIcon.getImage().getScaledInstance(200, 200, Image.SCALE_SMOOTH);
        Image enlargedImg = originalIcon.getImage().getScaledInstance(250, 250, Image.SCALE_SMOOTH);

        // Assign scaled images to ImageIcon variables
        originalIcon = new ImageIcon(originalImg);
        enlargedIcon = new ImageIcon(enlargedImg);

        imageLabel = new JLabel(originalIcon);
        imageLabel.setHorizontalAlignment(JLabel.CENTER);

        // 3. Add event listeners

        // ActionListener for the button (using a lambda expression)
        clickButton.addActionListener(e -> {
            clickCount++;
            clickTextField.setText("Button Clicks: " + clickCount);
        });

        // MouseListener for the image label (using a MouseAdapter)
        imageLabel.addMouseListener(new MouseAdapter() {
            @Override
            public void mouseEntered(MouseEvent e) {
                // Enlarge image when mouse enters
                imageLabel.setIcon(enlargedIcon);
            }

            @Override
            public void mouseExited(MouseEvent e) {
                // Restore image when mouse exits
                imageLabel.setIcon(originalIcon);
            }
        });

        // 4. Add components to the frame
        add(clickTextField, BorderLayout.NORTH);
        add(imageLabel, BorderLayout.CENTER);
        add(clickButton, BorderLayout.SOUTH);
    }

    /**
     * Main method to create and display the frame.
     */
    public static void main(String[] args) {
        // Ensure the GUI is created on the Event Dispatch Thread (EDT)
        SwingUtilities.invokeLater(() -> {
            new ImageFrame().setVisible(true);
        });
    }
}
