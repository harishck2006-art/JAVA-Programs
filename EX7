import javax.swing.*;
import java.awt.*;
import java.awt.event.ActionEvent;
import java.awt.event.ActionListener;
import java.util.regex.Pattern;

public class RegistrationForm extends JFrame implements ActionListener {

    // Components of the Form
    private final JLabel nameLabel, ageLabel, mailIdLabel, genderLabel, contactLabel;
    private final JTextField nameField, ageField, mailIdField, contactField;
    private final JRadioButton maleRadioButton, femaleRadioButton;
    private final ButtonGroup genderGroup;
    private final JButton okButton, clearButton;
    private final Container container;

    public RegistrationForm() {
        setTitle("User Registration Form");
        setBounds(300, 90, 500, 400);
        setDefaultCloseOperation(EXIT_ON_CLOSE);
        setResizable(false);

        container = getContentPane();
        container.setLayout(null);

        // Name
        nameLabel = new JLabel("Name");
        nameLabel.setFont(new Font("Arial", Font.PLAIN, 15));
        nameLabel.setBounds(50, 50, 100, 20);
        container.add(nameLabel);

        nameField = new JTextField();
        nameField.setFont(new Font("Arial", Font.PLAIN, 15));
        nameField.setBounds(150, 50, 250, 20);
        container.add(nameField);

        // Age
        ageLabel = new JLabel("Age");
        ageLabel.setFont(new Font("Arial", Font.PLAIN, 15));
        ageLabel.setBounds(50, 90, 100, 20);
        container.add(ageLabel);

        ageField = new JTextField();
        ageField.setFont(new Font("Arial", Font.PLAIN, 15));
        ageField.setBounds(150, 90, 250, 20);
        container.add(ageField);

        // Mail ID
        mailIdLabel = new JLabel("Mail ID");
        mailIdLabel.setFont(new Font("Arial", Font.PLAIN, 15));
        mailIdLabel.setBounds(50, 130, 100, 20);
        container.add(mailIdLabel);

        mailIdField = new JTextField();
        mailIdField.setFont(new Font("Arial", Font.PLAIN, 15));
        mailIdField.setBounds(150, 130, 250, 20);
        container.add(mailIdField);

        // Gender
        genderLabel = new JLabel("Gender");
        genderLabel.setFont(new Font("Arial", Font.PLAIN, 15));
        genderLabel.setBounds(50, 170, 100, 20);
        container.add(genderLabel);

        maleRadioButton = new JRadioButton("Male");
        maleRadioButton.setFont(new Font("Arial", Font.PLAIN, 15));
        maleRadioButton.setSelected(true);
        maleRadioButton.setBounds(150, 170, 80, 20);
        container.add(maleRadioButton);

        femaleRadioButton = new JRadioButton("Female");
        femaleRadioButton.setFont(new Font("Arial", Font.PLAIN, 15));
        femaleRadioButton.setBounds(240, 170, 80, 20);
        container.add(femaleRadioButton);

        genderGroup = new ButtonGroup();
        genderGroup.add(maleRadioButton);
        genderGroup.add(femaleRadioButton);

        // Contact Number
        contactLabel = new JLabel("Contact No");
        contactLabel.setFont(new Font("Arial", Font.PLAIN, 15));
        contactLabel.setBounds(50, 210, 100, 20);
        container.add(contactLabel);

        contactField = new JTextField();
        contactField.setFont(new Font("Arial", Font.PLAIN, 15));
        contactField.setBounds(150, 210, 250, 20);
        container.add(contactField);

        // Buttons
        okButton = new JButton("OK");
        okButton.setFont(new Font("Arial", Font.PLAIN, 15));
        okButton.setBounds(150, 280, 100, 30);
        container.add(okButton);

        clearButton = new JButton("Clear");
        clearButton.setFont(new Font("Arial", Font.PLAIN, 15));
        clearButton.setBounds(270, 280, 100, 30);
        container.add(clearButton);

        // Add action listeners
        okButton.addActionListener(this);
        clearButton.addActionListener(this);

        setVisible(true);
    }

    @Override
    public void actionPerformed(ActionEvent e) {
        if (e.getSource() == okButton) {
            validateAndSubmit();
        } else if (e.getSource() == clearButton) {
            clearFields();
        }
    }

    /**
     * Validates all form fields and submits if they are valid.
     */
    private void validateAndSubmit() {
        // Validation logic
        if (nameField.getText().isEmpty()) {
            showAlert("Name cannot be empty.");
            return;
        }
        if (!isValidAge(ageField.getText())) {
            showAlert("Please enter a valid age (numeric).");
            return;
        }
        if (!isValidEmail(mailIdField.getText())) {
            showAlert("Please enter a valid email address.");
            return;
        }
        if (!isValidContact(contactField.getText())) {
            showAlert("Please enter a valid 10-digit contact number.");
            return;
        }

        // If all validation passes, collect data and show display screen
        String name = nameField.getText();
        String age = ageField.getText();
        String mailId = mailIdField.getText();
        String gender = maleRadioButton.isSelected() ? "Male" : "Female";
        String contact = contactField.getText();

        // Create and show the display screen
        new DisplayScreen(name, age, mailId, gender, contact);
        this.dispose(); // Close the registration form
    }

    /**
     * Clears all the input fields in the form.
     */
    private void clearFields() {
        nameField.setText("");
        ageField.setText("");
        mailIdField.setText("");
        contactField.setText("");
        genderGroup.clearSelection();
        maleRadioButton.setSelected(true);
    }
    
    /**
     * Displays an alert message dialog.
     */
    private void showAlert(String message) {
        JOptionPane.showMessageDialog(this, message, "Validation Error", JOptionPane.ERROR_MESSAGE);
    }

    // --- Validation Helper Methods ---
    private boolean isValidAge(String age) {
        if (age.isEmpty()) return false;
        try {
            int ageVal = Integer.parseInt(age);
            return ageVal > 0 && ageVal < 120;
        } catch (NumberFormatException e) {
            return false;
        }
    }

    private boolean isValidEmail(String email) {
        String emailRegex = "^[a-zA-Z0-9_+&*-]+(?:\\.[a-zA-Z0-9_+&*-]+)*@(?:[a-zA-Z0-9-]+\\.)+[a-zA-Z]{2,7}$";
        Pattern pat = Pattern.compile(emailRegex);
        if (email == null) return false;
        return pat.matcher(email).matches();
    }

    private boolean isValidContact(String contact) {
        String contactRegex = "\\d{10}";
        Pattern pat = Pattern.compile(contactRegex);
        if (contact == null) return false;
        return pat.matcher(contact).matches();
    }

    public static void main(String[] args) {
        new RegistrationForm();
    }
}
