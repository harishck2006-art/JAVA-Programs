        displayArea.setFont(new Font("Arial", Font.PLAIN, 16));
        displayArea.setBounds(50, 50, 400, 250);
        displayArea.setEditable(false);
        displayArea.setLineWrap(true);
        displayArea.setWrapStyleWord(true);
        container.add(displayArea);
        
        setVisible(true);
    }
}
